#!/bin/sh
set -e

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Allow merge commits or interactive fixup/squash
case "$commit_msg" in
  Merge*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# Get current branch
branch=$(git branch --show-current 2>/dev/null || true)
if [ -z "$branch" ]; then
  exit 0
fi

case "$branch" in
  main|release/*|feat/*|fix/*|chore/*|proj/*)
    ;;
  *)
    echo "❌ Error: Branch '$branch' does not match naming conventions." >&2
    echo "   Allowed branch prefixes: feat/**, fix/**, chore/**, proj/**, release/**, or main" >&2
    exit 1
    ;;
esac

# Commit prefixes describe the change itself and are valid on every supported
# branch. The branch name does not constrain which supported prefix may be used.
case "$commit_msg" in
  "feat:"*|"feat("*"):"*|"fix:"*|"fix("*"):"*|"chore:"*|"chore("*"):"*|"proj:"*|"proj("*"):"*)
    exit 0
    ;;
  *)
    echo "❌ Error: Invalid commit message prefix." >&2
    echo "   Allowed prefixes: feat:, fix:, chore:, or proj:." >&2
    echo "   Received message: $commit_msg" >&2
    exit 1
    ;;
esac
