{
  "name": "uit-cli",
  "version": "2.0.0",
  "description": "CLI for courses.uit.edu.vn (Moodle)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanNg1403/uit-cli.git"
  },
  "type": "module",
  "bin": {
    "uit": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/provision-studio-chromium.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "studio:web:build": "npm run build && node scripts/build-studio.mjs",
    "studio:web:check": "npm run studio:web:build && node --check dist/studio-web-server.js && node --check dist/studio-web-launcher.js && node --check studio-build/renderer/web-bridge.js",
    "studio:package": "npm run studio:web:build && npm run runtime:prepare && node scripts/package-studio-standalone.mjs",
    "studio:package:smoke": "node scripts/smoke-standalone-studio.mjs",
    "installer:check": "sh -n scripts/install.sh && scripts/install.sh --help >/dev/null",
    "runtime:prepare": "node scripts/prepare-runtime-package.mjs",
    "standalone:package": "npm run build && scripts/package-standalone.sh macos $(node -p 'process.arch')",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:studio:web": "npm run studio:web:build && vitest run test/studio-web-server.test.ts && playwright test studio-ui sidebar studio-web --grep-invert='/pdf/i' --workers=1",
    "lint": "eslint .",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "postinstall": "node scripts/provision-studio-chromium.mjs",
    "typecheck": "npm run build && tsc --noEmit",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "studio:check": "npm run studio:web:build && npm run runtime:prepare && node scripts/check-studio-package.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
